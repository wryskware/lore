{
  // E2E round 1 — retrieval-ON arm. Select via OPENCODE_CONFIG.
  "$schema": "https://opencode.ai/config.json",
  // Mirror of the off arm: allow junction-crossing into Lexomancy-alt, since
  // headless `run` cannot answer the external_directory ask (deadlock).
  "permission": {
    "external_directory": "allow"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8:latest": {
          "name": "qwen3.8 (local)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    }
  },
  // Pinned copy, NOT the live target\debug build: a round must not be
  // re-pinned by whatever the working checkout last compiled. Populated by
  // `setup-worktrees.ps1 -Apply -PinBinary`; run.ps1 refuses to start a cell
  // if it is missing, and records its SHA-256 in every metrics.json.
  "mcp": {
    "lore": {
      "type": "local",
      "command": ["C:\\Users\\perag\\bench-e2e\\bin\\lore-mcp.exe"],
      "enabled": true
    }
  }
}
