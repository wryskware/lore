{
  // E2E round 1 — retrieval-OFF arm. Configs MERGE with the global one (verified
  // 2026-08-15), so lore must be explicitly disabled here, not merely omitted.
  "$schema": "https://opencode.ai/config.json",
  // Lexomancy-bench reaches Lexomancy-alt through junctions; headless `run`
  // has no UI to answer the external_directory ask, so it deadlocks the cell
  // (qwen lexomancy-off-T1 wedged twice on this, 2026-08-16).
  "permission": {
    "external_directory": "allow"
  },
  // Mirrors the on arm's pinned path so the two configs differ in exactly one
  // key (`enabled`). Never launched here — the block exists only to override
  // the global config's lore entry, which would otherwise merge in.
  "mcp": {
    "lore": {
      "type": "local",
      "command": ["C:\\Users\\perag\\bench-e2e\\bin\\lore-mcp.exe"],
      "enabled": false
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8:latest": {
          "name": "qwen3.8 (local)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    }
  }
}
